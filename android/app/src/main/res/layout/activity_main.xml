<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Compact, map-native identity/status surface. -->
    <LinearLayout
        android:id="@+id/unitChip"
        android:layout_width="wrap_content"
        android:layout_height="52dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="12dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_map_chip"
        android:elevation="7dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="16dp">

        <View
            android:id="@+id/liveDot"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:background="@drawable/bg_status_dot_live" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/unitTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Ambulance"
                android:textColor="@color/app_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/mapUpdateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif"
                android:text="Not registered"
                android:textColor="@color/app_muted"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/configToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_map_fab"
        android:contentDescription="Tracker settings"
        android:drawableStart="@drawable/ic_settings"
        android:elevation="7dp"
        android:gravity="center"
        android:minWidth="0dp"
        android:padding="13dp"
        android:text=""
        android:visibility="gone" />

    <Button
        android:id="@+id/recenterButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="260dp"
        android:background="@drawable/bg_map_fab"
        android:contentDescription="Center map on ambulance"
        android:drawableStart="@drawable/ic_my_location"
        android:elevation="7dp"
        android:gravity="center"
        android:minWidth="0dp"
        android:padding="13dp"
        android:text="" />

    <!-- Daily-use surface: state and telemetry only. -->
    <LinearLayout
        android:id="@+id/operationalSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="18dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp">

        <FrameLayout
            android:id="@+id/sheetHandle"
            android:layout_width="match_parent"
            android:layout_height="28dp"
            android:clickable="true"
            android:contentDescription="Expand or collapse tracking controls"
            android:focusable="true">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center"
                android:background="@color/app_line" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Checking tracker…"
                    android:textColor="@color/app_text"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/coordsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Restoring last state"
                    android:textColor="@color/app_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/batteryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/app_panel_2"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="—"
                android:textColor="@color/app_text"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="@color/app_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Speed" android:textColor="@color/app_muted" android:textSize="10sp" />
                <TextView android:id="@+id/speedText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:text="—" android:textColor="@color/app_text" android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="GPS" android:textColor="@color/app_muted" android:textSize="10sp" />
                <TextView android:id="@+id/accuracyText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:text="—" android:textColor="@color/app_text" android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Network" android:textColor="@color/app_muted" android:textSize="10sp" />
                <TextView android:id="@+id/networkText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:fontFamily="sans-serif-medium" android:text="—" android:textColor="@color/app_text" android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/bufferText" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="sans-serif" android:text="0 pending" android:textColor="@color/app_muted" android:textSize="10sp" />
            <TextView android:id="@+id/serverStateText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="sans-serif" android:text="Registered" android:textColor="@color/app_muted" android:textSize="10sp" />
        </LinearLayout>

        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_primary"
            android:enabled="false"
            android:fontFamily="sans-serif-medium"
            android:text="Checking tracker…"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/stopButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_stop"
            android:fontFamily="sans-serif-medium"
            android:text="Stop tracking"
            android:textAllCaps="false"
            android:textColor="@color/app_red"
            android:textSize="15sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Settings is deliberately separate from enrollment and day-to-day tracking. -->
    <LinearLayout
        android:id="@+id/settingsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/app_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Tracker settings"
            android:textColor="@color/app_text"
            android:textSize="22sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans-serif"
            android:text="Connected ambulance"
            android:textColor="@color/app_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/registeredUnitText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-medium"
            android:text="Ambulance"
            android:textColor="@color/app_text"
            android:textSize="18sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/app_line" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Background tracking"
                    android:textColor="@color/app_text"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/backgroundModeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="sans-serif"
                    android:text="Checking battery settings…"
                    android:textColor="@color/app_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/backgroundSettingsButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_quiet"
                android:fontFamily="sans-serif-medium"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Open"
                android:textAllCaps="false"
                android:textColor="@color/app_blue"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif"
            android:text="Re-register only when dispatch moves this phone to another ambulance."
            android:textColor="@color/app_muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/openReregisterButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_quiet"
            android:fontFamily="sans-serif-medium"
            android:text="Re-register tracker"
            android:textAllCaps="false"
            android:textColor="@color/app_blue"
            android:textSize="14sp" />

        <Button
            android:id="@+id/closeSettingsButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="Done"
            android:textAllCaps="false"
            android:textColor="@color/app_muted"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- First-run/re-registration surface. No endpoint or secret is exposed. -->
    <LinearLayout
        android:id="@+id/setupSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_sheet"
        android:elevation="20dp"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:visibility="gone">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@color/app_line" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Connect this phone"
            android:textColor="@color/app_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/connectionHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:text="Enter the 8-character code shown by dispatch."
            android:textColor="@color/app_muted"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/registrationCodeInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_input"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:hint="ABCD1234"
            android:imeOptions="actionDone"
            android:inputType="textCapCharacters|textNoSuggestions"
            android:letterSpacing="0.12"
            android:maxLength="8"
            android:singleLine="true"
            android:textAlignment="center"
            android:textColor="@color/app_text"
            android:textColorHint="#80868B"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans-serif"
            android:text="Codes expire after 10 minutes and work once."
            android:textColor="@color/app_muted"
            android:textSize="11sp" />

        <Button
            android:id="@+id/saveSetupButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_button_primary"
            android:fontFamily="sans-serif-medium"
            android:text="Connect tracker"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <Button
            android:id="@+id/cancelSetupButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@android:color/transparent"
            android:fontFamily="sans-serif-medium"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/app_muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>

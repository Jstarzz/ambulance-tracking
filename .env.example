POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ambulance:change-me@db:5432/ambulance?sslmode=disable
HTTP_ADDR=:8080
PUBLIC_ORIGIN=localhost:*
SECURE_COOKIES=false
BOOTSTRAP_ADMIN_USERNAME=dispatcher
BOOTSTRAP_ADMIN_PASSWORD=change-this-now
DEMO_VEHICLE_CODE=AMB-01
DEMO_DEVICE_KEY=replace-with-a-random-32-byte-secret

# OSRM-compatible routing server. Docker Compose falls back to the public OSRM
# demo service for field/prototype use when this is left blank. Production should
# point this at a self-hosted router so road routing is not dependent on a demo API.
ROUTER_URL=
ETA_FALLBACK_KPH=35

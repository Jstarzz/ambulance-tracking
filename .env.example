POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://ambulance:change-me@db:5432/ambulance?sslmode=disable
HTTP_ADDR=:8080
PUBLIC_ORIGIN=localhost:*
SECURE_COOKIES=false
BOOTSTRAP_ADMIN_USERNAME=dispatcher
BOOTSTRAP_ADMIN_PASSWORD=change-this-now
DEMO_VEHICLE_CODE=AMB-01
DEMO_DEVICE_KEY=replace-with-a-random-32-byte-secret

# Optional until TOTP MFA is enabled. Generate 32 random bytes and base64-encode them.
# Example: openssl rand -base64 32
MFA_ENCRYPTION_KEY=

# Optional OSRM-compatible routing service. When unset, ETA uses a clearly-marked
# straight-line/kinematic fallback instead of pretending it has road routing.
ROUTER_URL=
ETA_FALLBACK_KPH=35

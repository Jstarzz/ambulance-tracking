# Public hostname configured as a Cloudflare Tunnel published application.
PUBLIC_ORIGIN=tracking.example.kn
SECURE_COOKIES=true

# Cloudflare remotely-managed tunnel token. Treat this like a password.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

POSTGRES_PASSWORD=replace-with-a-random-database-password
DATABASE_URL=postgres://ambulance:replace-with-a-random-database-password@db:5432/ambulance?sslmode=disable
HTTP_ADDR=:8080

BOOTSTRAP_ADMIN_USERNAME=dispatcher
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
DEMO_VEHICLE_CODE=AMB-01
DEMO_DEVICE_KEY=replace-with-a-random-32-byte-device-secret

# Required before enabling TOTP MFA for any dispatcher/admin account. Generate
# once, store with the rest of the deployment secrets, and back it up securely.
# Example: openssl rand -base64 32
MFA_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Optional OSRM-compatible routing service for road ETA. Leave blank to use the
# explicitly-marked kinematic fallback.
ROUTER_URL=
ETA_FALLBACK_KPH=35
